APP_NAME=AI Data Pipeline Copilot
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ai_pipeline_copilot
POSTGRES_USER=copilot_user
POSTGRES_PASSWORD=replace-with-local-postgres-password


# Gemini API configuration. Do not commit real API keys.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=gemini-3.6-flash
